# opvane — Environment Configuration
#
# Copy this file to .env and edit the values for your environment.

# --- Server ---
PORT=51763
# BIND address inside the container; 0.0.0.0 is required for Docker.
BIND=0.0.0.0

# --- Security ---
# Set an API key to protect write endpoints (board tasks, content editing).
# Leave empty to allow unauthenticated writes (not recommended for production).
MISSION_CONTROL_API_KEY=

# --- Hermes Home ---
# Absolute path to the Hermes state directory on the host machine.
# This is mounted read-only into the container for agent-logs and state access.
HERMES_HOME=/home/user/.hermes

# --- Content Directory ---
# Where markdown content files are stored inside the container.
MISSION_CONTROL_CONTENT_DIR=/app/content
